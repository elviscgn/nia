{
  "name": "nia-spike",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm dev:clean-cef && concurrently -k -n nia,sample \"pnpm dev:nia\" \"pnpm dev:sample\"",
    "dev:clean-cef": "pkill -x Nia 2>/dev/null || true; pkill -f 'Nia Helper' 2>/dev/null || true; rm -rf \"$HOME/Library/Caches/dev.nia.app/cef\"",
    "dev:nia": "vite --host 127.0.0.1 --port 1420",
    "dev:sample": "vite --config sample.vite.config.ts --host 127.0.0.1 --port 1421",
    "build": "tsc && vite build",
    "setup:mac": "zsh scripts/setup-macos.sh",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "3.0.0-alpha.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "3.0.0-alpha.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.4",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
